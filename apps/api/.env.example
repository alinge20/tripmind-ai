# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a Git.
# Todos los valores de ejemplo son ficticios.

# development | production
APP_ENV=development

# Orígenes del navegador autorizados a llamar a la API (separados por comas).
CORS_ORIGINS=http://localhost:3000

# Zona horaria de referencia para validar fechas ("hoy").
DEFAULT_TIMEZONE=America/Bogota

# Peticiones POST permitidas por minuto y por IP (protección básica contra abuso).
RATE_LIMIT_PER_MINUTE=20

# Clave del proveedor de IA (Fase 4). Déjala vacía hasta tener una clave real.
# Ejemplo ficticio: OPENAI_API_KEY=sk-EJEMPLO-NO-ES-UNA-CLAVE-REAL
OPENAI_API_KEY=
